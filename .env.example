# Public site URL used for metadata (canonical/OG). Optional in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
# The anon key is safe to expose; the enquiries table is insert-only for it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the private /gajananadmin CRM to read, update and
# delete enquiries. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allow-list of admin login emails. Access is denied when this
# is empty. Example: ADMIN_EMAILS=you@example.com,sales@example.com
ADMIN_EMAILS=

# Optional. Database allowance shown on the CRM storage tab, in MB.
# Leave unset for the 500 MB default. Set this to the plan shown in Supabase.
SUPABASE_DB_LIMIT_MB=500
