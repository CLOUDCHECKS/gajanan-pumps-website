# Public site URL used for metadata (canonical/OG). Optional in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
# The anon key is intended for browser/server use with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for the forthcoming admin panel. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
